{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ironclad Clickwrap Activity Sites API",
    "version": "1.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sites",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sites",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pactsafe.io/sites"
          },
          "docs": "List sites"
        },
        {
          "info": {
            "name": "Get a site",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pactsafe.io/sites/:siteId",
            "params": [
              {
                "name": "siteId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a site"
        }
      ]
    }
  ],
  "bundled": true
}